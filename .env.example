# Postgres connection string — get this free from supabase.com or neon.tech
DATABASE_URL="postgresql://user:password@host:5432/roster"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud project (console.cloud.google.com) — enable "YouTube Data API v3"
# and create OAuth 2.0 credentials. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta developer app (developers.facebook.com) — add "Instagram Graph API" product.
# Requires an Instagram professional account linked to a Facebook Page, and
# app review before this works for real users beyond your test list.
META_APP_ID=""
META_APP_SECRET=""
