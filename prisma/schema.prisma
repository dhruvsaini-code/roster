// Roster — core data model
// Run `npx prisma migrate dev` once DATABASE_URL is set in .env to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BRAND
  CREATOR
}

enum Platform {
  INSTAGRAM
  YOUTUBE
}

enum ApplicationStatus {
  APPLIED
  INVITED
  SHORTLISTED
  HIRED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          Role
  createdAt     DateTime @default(now())

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  bio         String?
  niche       String?
  city        String?
  ratePerPost Int?

  connectedAccounts ConnectedAccount[]
  applications      Application[]
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String
  website     String?

  offers Offer[]
}

// One row per social account a creator has connected (Instagram, YouTube, etc).
// accessToken/refreshToken should be encrypted at rest in a real deployment —
// this schema stores them as-is only as a starting point.
model ConnectedAccount {
  id               String   @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  platform         Platform
  handle           String
  accessToken      String
  refreshToken     String?
  followerCount    Int?
  engagementRate   Float?
  verified         Boolean  @default(false)
  lastSyncedAt     DateTime?

  @@unique([creatorProfileId, platform])
}

model Offer {
  id            String   @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])
  title         String
  niche         String
  deliverables  String
  budgetMin     Int
  budgetMax     Int
  deadline      DateTime
  createdAt     DateTime @default(now())

  applications Application[]
}

model Application {
  id               String   @id @default(cuid())
  offerId          String
  offer            Offer    @relation(fields: [offerId], references: [id])
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  status           ApplicationStatus @default(APPLIED)
  pitch            String?
  proposedRate     Int?
  createdAt        DateTime @default(now())

  @@unique([offerId, creatorProfileId])
}
